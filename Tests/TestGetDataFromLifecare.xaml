      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[dateFrom]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[New DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).ToString("yyyyMMdd")]</InArgument>
