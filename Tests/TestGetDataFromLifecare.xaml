    <ui:GetRobotAsset TimeoutMS="{x:Null}" AssetName="LifeCareECDomainUrl" CacheStrategy="None" DisplayName="Get Asset DomainUrl" sap2010:WorkflowViewState.IdRef="GetRobotAsset_1">
