    <Assign DisplayName="Assign domainUrl" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[domainUrl]</OutArgument>
      </Assign.To>
      <Assign.Value>
