      <Variable x:TypeArguments="x:Object" Name="domainIdObj" />
      <Variable x:TypeArguments="x:String" Name="credUser" />
      <Variable x:TypeArguments="ss:SecureString" Name="apiKey" />
      <Variable x:TypeArguments="x:String" Name="domainUrl" />
      <Variable x:TypeArguments="x:String" Name="domainId" />
      <Variable x:TypeArguments="x:String" Name="dateFrom" />
      <Variable x:TypeArguments="x:String" Name="dateTo" />
